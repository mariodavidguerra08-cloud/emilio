<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Dulce Fruta: mermeladas artesanales elaboradas con fruta natural.">
  <title>Dulce Fruta | Mermeladas Artesanales</title>
  <style>
    :root {
      --verde: #547b43;
      --verde-oscuro: #304d2b;
      --crema: #fff9ed;
      --rosa: #f8e5e5;
      --texto: #302b25;
      --amarillo: #f5d66e;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: Arial, Helvetica, sans-serif;
      color: var(--texto);
      background: #fffdf8;
      line-height: 1.6;}  header {background: rgba(255,253,248,.96);position: sticky; top: 0;z-index: 10;box-shadow: 0 2px 14px rgba(0,0,0,.07);}
    .barra {
      max-width: 1150px;
      margin: auto;
      padding: 14px 5%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    .logo {
      color: var(--verde-oscuro);
      font-size: 1.55rem;
      font-weight: 900;
      letter-spacing: 1px;
      text-decoration: none;
    }
    .logo span { color: #d94f62; }
    nav { display: flex; gap: 24px; align-items: center; }
    nav a {
      text-decoration: none;
      color: var(--texto);
      font-weight: 700;
      font-size: .95rem;
    }
    nav a:hover { color: var(--verde); }
    .carrito {
      border: 0;
      border-radius: 25px;
      padding: 10px 16px;
      background: var(--verde);
      color: white;
      font-weight: bold;
      cursor: pointer;
    }
    .hero {
      min-height: 490px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 35px;
      padding: 65px max(5%, calc((100% - 1100px)/2));
      background: linear-gradient(110deg, #fff4e5 0%, #f7e9d7 52%, #e8efd9 100%);
    }
    .hero h1 {
      color: var(--verde-oscuro);
      font-family: Georgia, serif;
      font-size: clamp(2.5rem, 5vw, 4.3rem);
      line-height: 1.08;
      margin-bottom: 18px;
    }
    .hero p { max-width: 510px; font-size: 1.08rem; margin-bottom: 26px; }
    .etiqueta {
      color: #b64d4d;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-size: .8rem;
      margin-bottom: 12px;
    }
    .boton {
      display: inline-block;
      background: var(--verde);
      color: white;
      padding: 13px 23px;
      border-radius: 30px;
      text-decoration: none;
      border: 0;
      cursor: pointer;
      font-weight: 700;
      transition: .2s;
    }
    .boton:hover { background: var(--verde-oscuro); transform: translateY(-2px); }
    .hero img {
      width: 100%;
      height: 340px;
      object-fit: cover;
      border-radius: 22px;
      box-shadow: 0 15px 35px rgba(74,54,29,.18);
    }
    section { padding: 70px 5%; }
    .contenedor { max-width: 1100px; margin: auto; }
    .titulo { text-align: center; margin-bottom: 35px; }
    .titulo h2 {
      color: var(--verde-oscuro);
      font-family: Georgia, serif;
      font-size: clamp(2rem, 4vw, 2.7rem);
      margin-bottom: 8px;
    }
    .titulo p { color: #756d61; }
    .sabores { background: #fffdf8; }
    .productos {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .producto {
      background: white;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 6px 24px rgba(55,44,27,.09);
      border: 1px solid #f1eadf;
      transition: .2s;
    }
    .producto:hover { transform: translateY(-5px); }
    .producto img { width: 100%; height: 220px; object-fit: cover; display: block; }
    .producto-info { padding: 20px; }
    .producto h3 { color: var(--verde-oscuro); font-size: 1.25rem; }
    .producto p { color: #746d64; font-size: .93rem; min-height: 48px; margin: 7px 0 13px; }
    .precio { color: #c64f5d; font-size: 1.35rem; font-weight: 900; margin-bottom: 13px; }
    .producto .boton { width: 100%; }
    .presentaciones { background: var(--crema); }
    .tabla-precios {
      width: 100%;
      border-collapse: collapse;
      background: white;
      border-radius: 15px;
      overflow: hidden;
      box-shadow: 0 5px 20px rgba(55,44,27,.07);
    }
    .tabla-precios th, .tabla-precios td {
      padding: 17px 20px;
      text-align: left;
      border-bottom: 1px solid #eee8dc;
    }
    .tabla-precios th { background: var(--verde); color: white; }
    .tabla-precios tr:last-child td { border-bottom: 0; }
    .tabla-precios td:last-child { font-weight: 900; color: #c64f5d; }
    .nosotros {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 35px;
      align-items: center;
    }
    .nosotros img { width: 100%; height: 300px; object-fit: cover; border-radius: 18px; }
    .nosotros h2 { color: var(--verde-oscuro); font-family: Georgia,serif; font-size: 2.2rem; margin-bottom: 14px; }
    .contacto { background: #edf2e7; text-align: center; }
    .contacto p { margin: 10px auto 22px; max-width: 600px; }
    footer {
      background: #263b25;
      color: white;
      text-align: center;
      padding: 25px 5%;
      font-size: .9rem;
    }
    .aviso-carrito { margin-top: 12px; color: var(--verde-oscuro); font-weight: bold; min-height: 24px; }
    @media (max-width: 760px) {
      .barra { flex-wrap: wrap; justify-content: center; }
      nav { order: 3; width: 100%; justify-content: center; gap: 16px; flex-wrap: wrap; }
      nav a { font-size: .88rem; }
      .hero { grid-template-columns: 1fr; padding-top: 48px; }
      .hero img { height: 250px; }
      .productos { grid-template-columns: 1fr; max-width: 430px; margin: auto; }
      .nosotros { grid-template-columns: 1fr; }
      section { padding: 52px 5%; }
      .tabla-precios th, .tabla-precios td { padding: 13px 10px; font-size: .9rem; }
    }
  </style>
</head>
<body>
  <header>
    <div class="barra">
      <a class="logo" href="#inicio">DULCE <span>FRUTA</span> 🍓</a>
      <nav>
        <a href="#inicio">Inicio</a>
        <a href="#productos">Productos</a>
        <a href="#precios">Precios</a>
        <a href="#nosotros">Nosotros</a>
        <a href="#contacto">Contacto</a>
      </nav>
      <button class="carrito" onclick="verCarrito()">🛒 Carrito: <span id="cantidad">0</span></button>
    </div>
  </header>

  <main>
    <section class="hero" id="inicio">
      <div>
        <div class="etiqueta">Hechas con fruta natural</div>
        <h1>El sabor natural de la fruta</h1>
        <p>Disfruta nuestras mermeladas artesanales, preparadas con dedicación y el auténtico sabor de cada fruta. ¡Un toque dulce para cada momento!</p>
        <a class="boton" href="#productos">Ver productos</a>
      </div>
      <img src="https://images.unsplash.com/photo-1563805042-7684c019e1cb?auto=format&fit=crop&w=1000&q=85" alt="Frutas frescas y mermelada artesanal">
    </section>

    <section class="sabores" id="productos">
      <div class="contenedor">
        <div class="titulo">
          <h2>Nuestros sabores</h2>
          <p>Encuentra tu mermelada favorita.</p>
        </div>
        <div class="productos">
          <article class="producto">
            <img src="https://images.unsplash.com/photo-1464965911861-746a04b4bca6?auto=format&fit=crop&w=900&q=85" alt="Fresas frescas">
            <div class="producto-info">
              <h3>Mermelada de fresa</h3>
              <p>El sabor dulce y delicioso de las fresas seleccionadas.</p>
              <div class="precio">Q25.00</div>
              <button class="boton" onclick="agregar('Mermelada de fresa',25)">Agregar al carrito</button>
            </div>
          </article>
          <article class="producto">
            <img src="https://images.unsplash.com/photo-1550258987-190a2d41a8ba?auto=format&fit=crop&w=900&q=85" alt="Piña fresca">
            <div class="producto-info">
              <h3>Mermelada de piña</h3>
              <p>Una mezcla tropical con el toque natural de la piña.</p>
              <div class="precio">Q25.00</div>
              <button class="boton" onclick="agregar('Mermelada de piña',25)">Agregar al carrito</button>
            </div>
          </article>
          <article class="producto">
            <img src="https://images.unsplash.com/photo-1560806887-1e4cd0b6cbd6?auto=format&fit=crop&w=900&q=85" alt="Manzanas frescas">
            <div class="producto-info">
              <h3>Mermelada de manzana</h3>
              <p>Suave, aromática y perfecta para acompañar tus desayunos.</p>
              <div class="precio">Q25.00</div>
              <button class="boton" onclick="agregar('Mermelada de manzana',25)">Agregar al carrito</button>
            </div>
          </article>
        </div>
        <p class="aviso-carrito" id="mensaje"></p>
      </div>
    </section>

    <section class="presentaciones" id="precios">
      <div class="contenedor">
        <div class="titulo">
          <h2>Precios y presentaciones</h2>
          <p>Elige el tamaño ideal para ti.</p>
        </div>
        <table class="tabla-precios">
          <thead><tr><th>Presentación</th><th>Tamaño</th><th>Precio</th></tr></thead>
          <tbody>
            <tr><td>Pequeña</td><td>250 ml</td><td>Q15.00</td></tr>
            <tr><td>Mediana</td><td>500 ml</td><td>Q25.00</td></tr>
            <tr><td>Grande familiar</td><td>1000 ml</td><td>Q50.00</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section id="nosotros">
      <div class="contenedor nosotros">
        <img src="https://images.unsplash.com/photo-1490598000245-075175152d25?auto=format&fit=crop&w=1000&q=85" alt="Frutas frescas para preparar mermeladas">
        <div>
          <div class="etiqueta">Nuestra esencia</div>
          <h2>Hecho con cariño y sabor natural</h2>
          <p>En Dulce Fruta creemos que los mejores momentos se disfrutan con sabores auténticos. Elaboramos mermeladas artesanales inspiradas en la frescura de la fruta y en el cariño de lo hecho en casa.</p>
        </div>
      </div>
    </section>

    <section class="contacto" id="contacto">
      <div class="contenedor">
        <h2>¡Haz tu pedido!</h2>
        <p>¿Ya encontraste tu sabor favorito? Escríbenos para consultar disponibilidad y realizar tu pedido.</p>
        <!-- Reemplaza el número de ejemplo por tu número de WhatsApp, con código de país y sin espacios. -->
        <a class="boton" href="https://wa.me/50200000000" target="_blank" rel="noopener">Contactar por WhatsApp</a>
      </div>
    </section>
  </main>

  <footer>
    <p>© 2026 Dulce Fruta · Mermeladas Artesanales</p>
    <p>Elaboradas con sabor natural 🍓</p>
  </footer>

  <script>
    let totalProductos = 0;
    const pedidos = [];

    function agregar(nombre, precio) {
      pedidos.push({ nombre: nombre, precio: precio });
      totalProductos++;
      document.getElementById("cantidad").textContent = totalProductos;
      document.getElementById("mensaje").textContent =
        nombre + " se agregó al carrito.";
    }

    function verCarrito() {
      if (pedidos.length === 0) {
        alert("Tu carrito está vacío.");
        return;
      }

      let resumen = "Tu pedido:\\n";
      let total = 0;

      pedidos.forEach(function(producto, indice) {
        resumen += (indice + 1) + ". " + producto.nombre +
                   " - Q" + producto.precio.toFixed(2) + "\\n";
        total += producto.precio;
      });

      resumen += "\\nTotal: Q" + total.toFixed(2);
      alert(resumen);
    }
  </script>
</body>
</html>
